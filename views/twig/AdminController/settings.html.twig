                <script type="text/javascript">
                    document.addEventListener("DOMContentLoaded", function () {
                        const submitSearchFilters = document.getElementById("submitSearchFilters");
                        if (submitSearchFilters) {
                            submitSearchFilters.addEventListener("click", async (e) =>{
                                e.preventDefault();
                                const btn = e.currentTarget;
                                btn.disabled = true;
                                
                                const formData = new FormData(document.getElementById("form-search-filters"));

                                formData.append("action", "saveSearchFilters");
                                formData.append("ajax", "1");

                                // Gestione corretta dei campi multipli
                                const json = {};
                            
                                for (const [key, value] of formData.entries()) {
                                    if (key.endsWith('[]')) {
                                        // Per i campi multipli, usa getAll
                                        const values = formData.getAll(key);
                                        json[key] = String(values).split(',');
                                    } else {
                                        json[key] = [value];
                                    }
                                }
                                
                                console.log("JSON", json);
                                
                                const response = await doFetchPost("{{ adminControllerUrl | raw }}", json);
                                
                                showAlert(response, btn);
                                
                                return false;
                            });
                        }
                    });
                </script>
            </div>
        </div>
