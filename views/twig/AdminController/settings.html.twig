    <!-- Dati per JavaScript -->
    <script src="{{ baseUrl }}modules/mpapityres/views/assets/js/doFetchPost.js"></script>
    <script type="text/javascript">
        // URL per le azioni AJAX
        const baseUrl = "{{ baseUrl | raw }}";
        const CronControllerURL = "{{ cronControllerUrl | raw }}";
        const AdminControllerUrl = "{{ adminControllerUrl | raw }}";
        const DownloadCatalogActionUrl = "{{ downloadCatalogActionUrl | raw }}";
        const ImportCatalogActionUrl = "{{ importCatalogActionUrl | raw }}";
        const ReloadImagesActionUrl = "{{ reloadImagesActionUrl | raw }}";
        const DeleteProductsActionUrl = "{{ deleteProductsActionUrl | raw }}";

        function showAlert(response, btn) {
            // Clona il template e crea l'alert
            const templateAlert = document.getElementById("template-alert");
            const alertWrapper = templateAlert.content.cloneNode(true).querySelector("div.alert");
            
            if (response.success) {
                alertWrapper.classList.remove("alert-danger");
                alertWrapper.classList.add("alert-success");
                alertWrapper.querySelector("span:last-child").textContent = response.message;
            } else {
                alertWrapper.classList.remove("alert-success");
                alertWrapper.classList.add("alert-danger");
                alertWrapper.querySelector("span:last-child").textContent = response.message;
            }
            
            const panel = btn.closest(".panel");

            if (panel) {
                const panelBody = panel.querySelector(".panel-body");
                if (panelBody) {
                    panelBody.insertAdjacentElement("afterbegin", alertWrapper);
                }
            }

            setTimeout(() => {
                alertWrapper.remove();
            }, 5000);

            btn.disabled = false;
        }

        document.addEventListener('DOMContentLoaded', function () {
            $('.chosen').chosen(
                {
                    placeholder: 'Seleziona',
                    allowClear: true,
                    width: '100%',
                    language: 'it',
                    theme: 'classic'
                }
            );
        });
    </script>
</section>
