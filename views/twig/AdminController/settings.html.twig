                        </div>
                        <div class="form-group mb-2">
                            <label for="password">Password</label>
                            <div class="input-group col-md-6">
                                <input type="password" name="password" id="password" class="form-control clipboard pointer" value="{{ password }}">
                                <div class="input-group-addon">
                                    <span class="input-group"><i class="material-icons f-1rem">key</i></span>
                                </div>
                            </div>
                            <small class="text-info" style="margin-top: 0.5rem; display: block;"><code>Inserisci la password del tuo account</code></small>
                        </div>
                        <div class="form-group">
                            <label for="csvToken">Token CSV</label>
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="input-group"><i class="fa-solid fa-key"></i></span>
                                </div>
                                <textarea name="csvToken" id="csvToken" class="form-control" rows="5">{{ csvToken }}</textarea>
                            </div>
                            <small class="text-info" style="margin-top: 0.5rem; display: block;"><code>Inserisci il token CSV (Alzura Article Export)</code></small>
                        </div>
                    </form>
                </div>
                <div class="panel-footer">
                    <div class="button-container d-flex justify-content-center align-items-center">
                        <button type="button" class="btn btn-primary" id="submitSaveAccount">
                            <i class="material-icons f-1rem">save</i>
                            Salva
                        </button>
                    </div>
                </div>
                <script type="text/javascript">
                    document.addEventListener("DOMContentLoaded", function () {
                        const submitSaveAccount = document.getElementById("submitSaveAccount");
                        if (submitSaveAccount) {
                            submitSaveAccount.addEventListener("click", async (e) =>{
                                e.preventDefault();
                                const btn = e.currentTarget;
                                btn.disabled = true;
                                
                                const formData = new FormData(document.getElementById("form-save-account"));

                                formData.append("action", "saveAccount");
                                formData.append("ajax", "1");

                                //Trasformo il formdata in json
                                const json = Object.fromEntries(formData.entries());
                                
                                const response = await doFetchPost("{{ adminControllerUrl | raw }}", json);
                                
                                showAlert(response, btn);
                                
                                return false;
                            });
                        }
                    });
                </script>
