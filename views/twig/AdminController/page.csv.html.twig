<script type="text/javascript">
    const AdminControllerUrl = "{{ adminControllerUrl | raw }}";
    const tablePriceReload = new TablePriceReload(AdminControllerUrl);

    document.addEventListener("DOMContentLoaded", function () {
        const btnSaveCsvAccount = document.getElementById("btnSaveCsvAccount");
        const toast = new ToastClass("toast-mpapityres");
        window.toast = toast;
        
        btnSaveCsvAccount.addEventListener("click", async (e) => {
            e.preventDefault();

            const icon = this.querySelector("i.material-icons").textContent;
            icon.textContent = "spinner";
            //Aspetto mezzo secondo per il refresh
            await new Promise(resolve => setTimeout(resolve, 500));

            const form = document.getElementById("formCsv");
            const formData = new FormData(form);
            formData.append("ajax", 1);
            formData.append("action", "saveCsvAccount");

            try {
                const response = await fetch(AdminControllerUrl, {
                    method: "POST",
                    body: formData,
                });
    
                const json = await response.json();

                const alert = createAlert(json.message, json.success ? 'success' : 'danger');
                document.getElementById("alertContainer").innerHTML = "";
                document.getElementById("alertContainer").appendChild(alert);
                icon.textContent = icon;
            } catch (error) {
                console.error("Error:", error);
            }
        });

        new PageCsv(AdminControllerUrl);
        tablePriceReload.createTable();
    });
</script>