            <tr class="table-info">
                <td colspan="3" class="font-weight-bold">SPECIFICHE TECNICHE</td>
            </tr>
            <tr><td><code>load_index</code></td><td>Indice di carico</td><td>String</td></tr>
            <tr><td><code>speed_index</code></td><td>Indice di velocità</td><td>String</td></tr>
