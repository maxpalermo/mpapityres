            <tr class="table-info">
                <td colspan="3" class="font-weight-bold">DIMENSIONI</td>
            </tr>
            <tr><td><code>outer_diameter</code></td><td>Diametro esterno (mm)</td><td>Float</td></tr>
            <tr><td><code>height</code></td><td>Altezza (mm)</td><td>Float</td></tr>
            <tr><td><code>width</code></td><td>Larghezza (mm)</td><td>Float</td></tr>
            <tr><td><code>inner_diameter</code></td><td>Diametro interno (pollici)</td><td>Float</td></tr>
            <tr><td><code>profile</code></td><td>Profilo</td><td>String</td></tr>
            
