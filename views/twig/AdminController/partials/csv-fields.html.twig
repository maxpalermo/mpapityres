            </tr>
            <tr><td><code>direct_link</code></td><td>Link diretto ALZURA T24</td><td>String</td></tr>
            <tr><td><code>info</code></td><td>Link profilo articolo</td><td>String</td></tr>
            <tr><td><code>image</code></td><td>URL immagine grande</td><td>String</td></tr>
            <tr><td><code>image_tn</code></td><td>URL immagine small</td><td>String</td></tr>
            <tr><td><code>tyrelabel_link</code></td><td>URL etichetta pneumatico</td><td>String</td></tr>
            <tr><td><code>data_sheet</code></td><td>URL scheda tecnica</td><td>String</td></tr>
            
            <!-- Altro -->
            <tr class="table-info">
                <td colspan="3" class="font-weight-bold">ALTRO</td>
            </tr>
            <tr><td><code>vehicle_class</code></td><td>Classe veicolo</td><td>String</td></tr>
            <tr><td><code>da_decke</code></td><td>Qualità degradata DA (1=sì, 0=no)</td><td>Integer</td></tr>
            <tr><td><code>demo</code></td><td>Articolo demo (1=sì, 0=no)</td><td>Integer</td></tr>
            <tr><td><code>dot</code></td><td>Marcatura DOT (1=sì, 0=no)</td><td>Integer</td></tr>
            <tr><td><code>dot_year</code></td><td>Anno produzione DOT</td><td>Integer</td></tr>
            <tr><td><code>manufacturer_description</code></td><td>Info sicurezza produttore</td><td>String</td></tr>

