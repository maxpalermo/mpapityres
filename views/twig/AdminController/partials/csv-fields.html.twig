            <tr class="table-info">
                <td colspan="3" class="font-weight-bold">CAMPI SU RICHIESTA (CON SOVRAPPREZZO)</td>
            </tr>
            <tr><td><code>EAN1</code></td><td>Codice EAN1</td><td>String</td></tr>
            <tr><td><code>EAN2</code></td><td>Codice EAN2</td><td>String</td></tr>
            <tr><td><code>EAN3</code></td><td>Codice EAN3</td><td>String</td></tr>
            <tr><td><code>cheapest_20</code></td><td>Prezzo più basso da 20 pezzi</td><td>Float</td></tr>
            <tr><td><code>manufacturer_price</code></td><td>Prezzo produttore</td><td>Float</td></tr>
