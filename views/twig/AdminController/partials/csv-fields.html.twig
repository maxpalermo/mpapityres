                <td colspan="3" class="font-weight-bold">INFORMAZIONI PRODOTTO</td>
            </tr>
            <tr><td><code>brandname</code></td><td>Marca</td><td>String</td></tr>
            <tr><td><code>articlename</code></td><td>Nome articolo</td><td>String</td></tr>
            <tr><td><code>description</code></td><td>Descrizione</td><td>String</td></tr>
            <tr><td><code>tyre_type</code></td><td>Tipo pneumatico</td><td>String</td></tr>
