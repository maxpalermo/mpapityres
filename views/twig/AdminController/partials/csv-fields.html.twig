            </tr>
        </thead>
        <tbody>
            <!-- Identificativi -->
            <tr class="table-info">
                <td colspan="3" class="font-weight-bold">IDENTIFICATIVI</td>
            </tr>
            <tr><td><code>id</code></td><td>ID unico pneumatico</td><td>Integer</td></tr>
            <tr><td><code>matchcode</code></td><td>Codice articolo</td><td>String</td></tr>
            <tr><td><code>manufacturer_number</code></td><td>Numero produttore</td><td>String</td></tr>
            
