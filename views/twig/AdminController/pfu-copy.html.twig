<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/instantsearch.css@7.1.0/themes/reset-min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/instantsearch.css@7.1.0/themes/algolia-min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/hover.css@2.3.2/css/hover.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.2/dist/bootstrap-table.min.css" />

<style>
    .wrapper-bootstrap {
        min-width: 1200px;
        padding: 110px 30px 100px;
        padding-left: 230px;
        background-color: #fff;
    }
    .form-inline {
        display: flex !important;
        justify-content: start !important;
        align-items: top !important;
        gap: 0.5rem !important;
    }

    .btn {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 0.5rem;
    }

    .mb-3 {
        margin-bottom: 1.5rem !important;
    }

    .mt-2 {
        margin-top: 1rem !important;
    }

    .gap-2 {
        gap: 1rem !important;
    }

    .flex-1 {
        flex: 1 !important;
    }

    .progress-bar-striped {
        background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.15) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0.15) 75%, transparent 75%, transparent);
        background-size: 1rem 1rem;
    }

    .progress-bar-animated {
        -webkit-animation: progress-bar-stripes 1s linear infinite;
        animation: progress-bar-stripes 1s linear infinite;
    }

    .col-6 {
        float: left;
        min-width: 0 !important;
        max-width: 50% !important;
    }

    .align-items-end {
        align-items: end !important;
    }

    label.label-line {
        display: block;
        float: none;
        width: auto;
        text-align: left;
        margin: 0;
        margin-bottom: 0.5rem;
    }
    .form-group {
        margin-bottom: 2rem !important;
    }

    .dropup .dropdown-menu {
        top: auto;
        bottom: 100%;
        margin-top: 0;
        margin-bottom: 0.125rem;
    }

    .bootstrap .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        display: none;
        float: left;
        min-width: 160px;
        padding: 5px 0;
        margin: 2px 0 0;
        list-style: none;
        font-size: 12px;
        background-color: #fff;
        border: 1px solid #ccc;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 4px;
        -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
        background-clip: padding-box;
        text-align: left;
    }

    .dropdown-item {
        display: block;
        width: 100%;
        padding: 0.25rem 1.5rem;
        clear: both;
        font-weight: 400;
        color: #212529;
        text-align: inherit;
        white-space: nowrap;
        background-color: transparent;
        border: 0;
        text-decoration: none !important;
    }

    .dropdown-item:hover {
        background-color: #dfdfdf;
    }

    .dropdown-item.active,
    .dropdown-item:active {
        color: #fff;
        text-decoration: none;
        background-color: #007bff;
    }
</style>

<!-- Template progress bar download -->
<template id="template-download-container">
    <div class="download-container">
        <button id="start-download" onclick="startDownload()">Scarica Catalogo</button>

        <div class="progress-container" style="display: none">
            <div class="progress">
                <div id="progress-bar" class="progress-bar" role="progressbar" style="width: 0%"></div>
            </div>
            <p id="progress-text">0% completato</p>
            <p id="download-speed">Velocità: 0 KB/s</p>
            <p id="download-eta">Tempo rimanente: Calcolo in corso...</p>
            <p id="download-size">Dimensione: 0 B / 0 B</p>
            <p id="download-status"></p>
        </div>
    </div>
</template>

<div class="flex-container">
    <div class="panel panel-default">
        <div class="panel-heading">
            <p class="d-flex align-items-center">
                <i class="material-icons mr-2">refresh</i>
                Crea prodotti PFU
            </p>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-6 mr-2">
                    <div class="form-group">
                        <label class="label-line" for="pfu-price-list">Inserisci la lista dei prezzi</label>
                        <textarea class="form-control" id="pfu-price-list" rows="10"></textarea>
                        <p>
                            <code>Inserisci il peso iniziale e finale in grammi separati da un trattino e poi dopo il punto e virgola inserisci il prezzo</code>
                        </p>
                        <p>
                            <code>ES: 0-2000;1.00 => da zero a 2 kg applica 1 Eur di contributo PFU</code>
                        </p>
                    </div>
                    <div class="form-group fixed-width-lg">
                        <label class="label-line" for="pfu-id-start">Inserisci l'id di partenza</label>
                        <input type="number" class="form-control" id="pfu-id-start" value="1" />
                    </div>
                    <div class="form-group fixed-width-xl">
                        <label class="label-line" for="pfu-tax-rule-group">Seleziona l'aliquota IVA</label>
                        <select class="form-control" id="pfu-tax-rule-group">
                            {% for tax_rule in taxRulesGroups %}
                            <option value="{{ tax_rule.id_tax_rules_group }}">{{ tax_rule.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group mt-2">
                        <button type="button" class="btn btn-secondary pull-right mr-2" id="btn-produtc-pfu">
                            <i class="material-icons mr-2">linear_scale</i>
                            Associa i prodotti a PFU
                        </button>

                        <button type="button" class="btn btn-primary pull-right mr-2" id="btn-create-pfu">
                            <i class="material-icons mr-2">play_arrow</i>
                            Crea prodotti PFU
                        </button>
                    </div>
                </div>
                <div class="col-6">
                    <label>Elenco prodotti PFU in archivio</label>
                    <table class="table table-condensed table-bordered" style="margin: 16px: auto;" id="table-pfu">
                        <thead>
                            <tr>
                                <th colspan="5" style="text-align: center">Elenco prodotti PFU in archivio</th>
                            </tr>
                            <tr>
                                <th>Id</th>
                                <th>Riferimento</th>
                                <th>Prodotto</th>
                                <th>Prezzo</th>
                                <th>Prodotti associati</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pfu in pfuList %}
                            <tr>
                                <td>{{ pfu.id_product }}</td>
                                <td>{{ pfu.reference }}</td>
                                <td>{{ pfu.name }}</td>
                                <td class="text-right">{{ pfu.price | number_format(2, ",", ".") }} EUR</td>
                                <td class="text-right">
                                    {% if pfu.products > 0 %}
                                    <span class="badge badge-info">{{ pfu.products }}</span>
                                    {% else %}
                                    <span class="badge badge-danger">0</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-2">
                <span id="create-pfu-progress-text">
                    <div class="alert alert-info">
                        <p>In attesa…</p>
                    </div>
                </span>
            </div>
            <div class="mt-2">
                <span id="create-pfu-inserted-result" class="text-success" style="display: none"></span>
            </div>
        </div>
    </div>
</div>

<!-- Pagina principale -->
<section class="bootstrap">
    <div class="row mb-4">
        <div class="col-12">
            <div class="panel panel-default">
                <div class="panel-body">
                    <div class="d-flex align-items-center">
                        <i class="material-icons mr-2 text-info">info</i>
                        <div>
                            <p class="mb-1"><strong>Assegna ai prodotti il corrispondente PFU</strong></p>
                            <ol class="mb-0">
                                <li>Filtra i prodotti</li>
                                <li>Seleziona i prodotti da associare a un determinato PFU</li>
                                <li>Premi il pulsante <strong>ASSOCIA</strong></li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sezione Filtri prodotti -->
    <div class="d-flex justify-content-start align-items-start gap-2">
        <div class="panel panel-default flex-1">
            <div class="panel-heading">
                <p class="panel-title d-flex align-items-center">
                    <i class="material-icons mr-2">article</i>
                    Associa
                </p>
            </div>

            <div class="panel-body">{% include '@Modules/mpapityres/views/twig/Table/Bootstrap/table.html.twig' with { tableId: 'table-pfu' } %}</div>
        </div>
    </div>

    <!-- Dati per JavaScript -->

    <script>
        $.browser = {};
    </script>

    <script src="https://cdn.jsdelivr.net/npm/jquery-hashchange@2.0.0/jquery.ba-hashchange.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/algoliasearch@3.32.0/dist/algoliasearchLite.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/instantsearch.js@3.0.0/dist/instantsearch.production.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/tableexport.jquery.plugin@1.29.0/tableExport.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.2/dist/bootstrap-table.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.2/dist/bootstrap-table-locale-all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.2/dist/extensions/export/bootstrap-table-export.min.js"></script>

    <script src="{{ baseUrl }}modules/mpapityres/views/assets/components/table/table.js"></script>
    <script src="{{ baseUrl }}modules/mpapityres/views/assets/js/remove-tree-buttons.js"></script>

    <script type="text/javascript">
        // URL per le azioni AJAX
        const baseUrl = "{{ baseUrl | raw }}";
        const CronControllerURL = "{{ cronControllerUrl | raw }}";
        const AdminControllerUrl = "{{ adminControllerUrl | raw }}";
        const DownloadCatalogActionUrl = "{{ downloadCatalogActionUrl | raw }}";
        const ImportCatalogActionUrl = "{{ importCatalogActionUrl | raw }}";
        const ReloadImagesActionUrl = "{{ reloadImagesActionUrl | raw }}";
        const DeleteProductsActionUrl = "{{ deleteProductsActionUrl | raw }}";
        const cronToken = "{{ cronToken }}";

        document.addEventListener("DOMContentLoaded", () => {
            $('.chosen').chosen(
                {
                    placeholder: 'Seleziona',
                    allowClear: true,
                    width: '100%',
                    language: 'it',
                    theme: 'classic'
                }
            );
            
            const divContent = document.getElementById("content");
            if (divContent) {
                divContent.classList.remove("nobootstrap");
                divContent.classList.add("wrapper-bootstrap");
                console.log("Nobootstrap rimosso");
            }
        });
    </script>
</section>
