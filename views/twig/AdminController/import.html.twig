<script src="{{ baseUrl}}modules/mpapityres/views/assets/components/bootstrap-table/themes/bootstrap-table/bootstrap-table.min.js"></script>
<script src="{{ baseUrl}}modules/mpapityres/views/assets/components/bootstrap-table/locale/bootstrap-table-it-IT.js"></script>
<script src="{{ baseUrl}}modules/mpapityres/views/assets/js/doFetchPost.js"></script>
<script src="{{ baseUrl }}modules/mpapityres/views/assets/js/remove-tree-buttons.js"></script>
<script src="{{ baseUrl }}modules/mpapityres/views/assets/js/Controllers/AdminMpApiTyres/classes/LoadPriceTable.js"></script>