<!-- PANNELLO ACCOUNT -->
<div class="panel panel-default">
    <div class="panel-heading">
        <span class="material-icons mr-2">person</span>
        <span>Account</span>
    </div>
    <div class="panel-body">
        <form action="{{ adminControllerUrl }}" method="post" id="formCsv">
            <div class="form-group">
                <label for="account_id">Utente</label>
                <input type="text" name="account_id" id="account_id" class="form-control" value="{{ account_id }}">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" class="form-control" value="{{ password }}">
            </div>
            <div class="form-group">
                <label for="csv_token">Token CSV</label>
                <textarea name="csv_token" id="csv_token" rows="10" class="form-control">{{ csv_token }}</textarea>
            </div>
            <button type="submit" id="btnSaveCsvAccount" class="btn btn-primary pull-right">
                <i class="material-icons">save</i>
                <span>Salva</span>
            </button>
        </form>
    </div>
</div>
<!-- END PANNELLO ACCOUNT -->