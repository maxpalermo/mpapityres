<script type="text/javascript">
    // URL per le azioni AJAX
    const baseUrl = "{{ baseUrl | raw }}";
    const CronControllerURL = "{{ cronControllerUrl | raw }}";
    const AdminControllerUrl = "{{ adminControllerUrl | raw }}";
    const DownloadCatalogActionUrl = "{{ downloadCatalogActionUrl | raw }}";
    const ImportCatalogActionUrl = "{{ importCatalogActionUrl | raw }}";
    const ReloadImagesActionUrl = "{{ reloadImagesActionUrl | raw }}";
    const DeleteProductsActionUrl = "{{ deleteProductsActionUrl | raw }}";
    const cronToken = "{{ cronToken }}";
    const toast = new ToastClass();
    const fetchClass = new Fetch(AdminControllerUrl, "mpapityres");
    const tablePfuAssociations = new TablePfuAssociation(AdminControllerUrl);

    async function generatePfuFromCsv()
    {
        try {
            toast.showToastInfo("Attendere...", "Generazione lista PFU in corso...");
            const data = await fetchClass.run("generatePfuFromCsv", {});
            if (data.success) {
                const tablePfu = document.getElementById("table-pfu");
                tablePfu.querySelector("tbody").innerHTML=data.tbody;
                toast.showToastSuccess("Operazione eseguita", "Lista PFU generata con successo!");
            } else {
                toast.showToastError("Errore", data.message || "Errore nella generazione della lista PFU");
            }
            
        } catch (error) {
            toast.showToastError("Attenzione", "Errore nella generazione della lista PFU: " + error.message);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const toast = new ToastClass("toast-mpapityres");
        window.toast = toast;

        const confirmation = new ConfirmClass("confirmation-mpapityres");
        window.confirmation = confirmation;

        $('.chosen').chosen(
            {
                placeholder: 'Seleziona',
                allowClear: true,
                width: '100%',
                language: 'it',
                theme: 'classic'
            }
        );
        
        const divContent = document.getElementById("content");
        if (divContent) {
            divContent.classList.remove("nobootstrap");
            divContent.classList.add("wrapper-bootstrap");
            console.log("Nobootstrap rimosso");
        }

        const btnSaveTaxRate = document.getElementById("btnSaveTaxRate");
        btnSaveTaxRate.addEventListener("click", async (e) => {
            e.preventDefault();

            if(await confirmation.confirmYesNo(
                "Richiesta",
                "Sei sicuro di voler salvare l'aliquota IVA?"
                )==false) {
                return;
            }

            const idTaxRulesGroup = document.getElementById("pfu-tax-rule-group").value;
            const formData = new FormData();
            formData.append("idTaxRulesGroup", idTaxRulesGroup);
            formData.append("action", "savePfuIdTaxRulesGroup");
            formData.append("ajax", 1);
            
            const response = await fetch("{{ adminControllerUrl }}", {
                method: "POST",
                body: formData
            });

            const json = await response.json();
            if (json.success) {
                toast.showToastSuccess("Operazione eseguita",json.message);
            } else {
                toast.showToastError("Operazione fallita",json.message);
            }
            
        });

        const btnSavePfu = document.getElementById("btnSavePfu");
        btnSavePfu.addEventListener("click", async (e) => {
            e.preventDefault();
            
        });

        tablePfuAssociations.createTable();
    });
</script>

