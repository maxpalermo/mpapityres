<style>
    .table-bordered td {
        border: 1px solid #dcdcdc !important;
    }
</style>

<div style="width: 100%">
    <!-- TEMPLATE ASSOCIA PFU -->
    {% include 'AdminController/pages/csv/pfu-association.html.twig' %}

    <div class="d-flex justify-content-start align-items-start gap-2">
        <!-- PANNELLO CSV -->
        <div class="panel panel-info">
            <div class="panel-heading">
                <i class="icon icon-cogs"></i>
                <span>Elenco PFU da CSV</span>
            </div>
            <div class="panel-body">
                <div class="alert alert-warning">
                    <p>Questa sezione permette di creare l'elenco dei PFU</p>
                    <p>standard <strong>ECOPNEUS</strong> letti dal file CSV</p>
                </div>
                <div class="form-group">
                    <table class="table table-bordered table-striped table-condensed" id="table-pfu-csv">
                        <thead>
                            <tr>
                                <th class="text-center">Peso min</th>
                                <th class="text-center">Peso max</th>
                                <th class="text-center">Prezzo</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pfu in pfuCsv %}
                            <tr>
                                <td class="text-right" data-min-weight="{{ pfu.min_weight }}">{{ pfu.min_weight }} Kg</td>
                                <td class="text-right" data-max-weight="{{ pfu.max_weight }}">{{ pfu.max_weight }} Kg</td>
                                <td class="text-right" data-price="{{ pfu.price }}">{{ pfu.price|number_format(2,',','.') }} €</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="panel-footer">
                <button class="btn btn-primary pull-right" onclick="generatePfuFromCsv()">Genera Lista PFU</button>
            </div>
        </div>

        <!-- PANNELLO CONTENITORE -->
        <div class="grow-1">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <i class="icon icon-cogs"></i>
                    <span>Crea prodotto PFU</span>
                </div>
                
                <hr>
                <div class="panel-body">
                    <form action="" method="post" id="formPfu" class="d-flex justify-content-start align-items-start gap-2">
                        <div class="form-group" style="border-right: 1px solid #dcdcdc; padding-right: 2rem;">
                            <div class="form-group fixed-width-xl">
                                <label class="label-line" for="pfu-tax-rule-group">Seleziona l'aliquota IVA</label>
                                <select class="form-control" id="pfu-tax-rule-group">
                                    {% for tax_rule in id_tax_rules_group_list %}
                                    <option value="{{ tax_rule.id_tax_rules_group }}" {% if tax_rule.id_tax_rules_group == id_pfu_tax_rules_group %}selected{% endif %}>{{ tax_rule.name }}</option>
                                    {% endfor %}
                                </select>
                                <button type="button" class="btn btn-primary mt-2 pull-right" id="btnSaveTaxRate">
                                    <i class="material-icons">save</i>
                                    Salva
                                </button>
                            </div>
                        </div>
                        <div class="form-group fixed-width-xl">
                            <label class="label-line" for="pfu-min-weight">Peso minimo</label>
                            <div class="input-group">
                                <input type="text" class="form-control text-right" id="pfu-min-weight" name="pfu-min-weight" value="0" required>
                                <span class="input-group-addon">Kg</span>
                            </div>
                        </div>
                        <div class="form-group fixed-width-xl">
                            <label class="label-line" for="pfu-max-weight">Peso massimo</label>
                            <div class="input-group">
                                <input type="text" class="form-control text-right" id="pfu-max-weight" name="pfu-max-weight" value="0" required>
                                <span class="input-group-addon">Kg</span>
                            </div>
                        </div>
                        <div class="form-group fixed-width-xl">
                            <label class="label-line" for="pfu-price">Prezzo</label>
                            <div class="input-group">
                                <input type="text" class="form-control text-right" id="pfu-price" name="pfu-price" value="0.00" required>
                                <span class="input-group-addon">EUR</span>
                            </div>
                            <button type="submit" id="btnSavePfu" class="btn btn-primary mt-2 pull-right">
                                <i class="material-icons">save</i>
                                <span>Salva</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="panel panel-success grow-1">
                <div class="panel-heading">
                    <i class="icon icon-list"></i>
                    <span>Elenco PFU in archivio</span>
                </div>
                <div class="panel-body">
                    <table class="table table-hover table-bordered" id="table-pfu">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Riferimento</th>
                                <th>Peso min</th>
                                <th>Peso max</th>
                                <th>Prezzo</th>
                                <th>IVA</th>
                                <th>Prodotti associati</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ pfuListTbody | raw }}
                        </tbody>
                    </table>
                </div>
                <div class="panel-footer">
                    <div class="text-right">
                        <ul class="list-group">
                            <li class="list-group-item">Totale PFU: <strong>{{ pfuList|length }}</strong></li>
                            <li class="list-group-item">Totale Prodotti: <strong>{{ totalProducts }}</strong></li>
                            <li class="list-group-item">Prodotti associati: <strong>{{ totalPfuAssociated }}</strong></li>
                        </ul>
                    </td>
                </div>
            </div>
        </div>
    </div>
</div>
    
<!-- SEZIONE ELENCO PFU CSV -->
<div class="d-flex justify-content-start align-items-start gap-2">
    <div class="panel panel-success grow-1">
        <div class="panel-heading">
            <i class="icon icon-list"></i>
            <span>Associa PFU ai prodotti</span>
        </div>
        <div class="panel-body">
            <table class="table table-hover table-bordered" id="table-pfu-association">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Riferimento</th>
                        <th>Peso min</th>
                        <th>Peso max</th>
                        <th>Prezzo</th>
                        <th>IVA</th>
                        <th>Prodotti associati</th>
                    </tr>
                </thead>
                <tbody>
                    {% for pfu in pfuList %}
                    <tr>
                        <td>{{ pfu.id_product }}</td>
                        <td>{{ pfu.reference }}</td>
                        <td class="text-right">{{ pfu.weightStart }} Kg</td>
                        <td class="text-right">{{ pfu.weightEnd }} Kg</td>
                        <td class="text-right">{{ pfu.price | number_format(2, ",", ".") }} EUR</td>
                        <td class="text-right">{{ pfu.tax_rate }} %</td>
                        <td class="text-right">
                            {% if pfu.associated > 0 %}
                            <span class="badge badge-info">{{ pfu.associated }}</span>
                            {% else %}
                            <span class="badge badge-danger">0</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="panel-footer">
            <div class="text-right">
                <ul class="list-group">
                    <li class="list-group-item">Totale PFU: <strong>{{ pfuList|length }}</strong></li>
                    <li class="list-group-item">Totale Prodotti: <strong>{{ totalProducts }}</strong></li>
                    <li class="list-group-item">Prodotti associati: <strong>{{ totalPfuAssociated }}</strong></li>
                </ul>
            </div>
        </div>
    </div>
</div>



